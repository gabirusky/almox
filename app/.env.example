# Copie para .env.local e preencha com valores do seu projeto Supabase.
# NUNCA commite chaves reais. O frontend usa apenas a chave publicável/anon.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Opcional — força a demo offline/mock (sem Supabase, dados no navegador).
# VITE_OFFLINE_MODE=true

# Opcional — caminho base do build. Vazio/" /" para desenvolvimento local.
# O deploy no GitHub Pages usa /almox/ (definido no workflow, não aqui).
# VITE_BASE_PATH=/almox/
